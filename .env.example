# Copy to .env for local runs. Never commit the real file.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
MASTER_KEY=            # npm run gen-key
APP_PASSWORD=          # the password you type to open the app
GH_TOKEN=              # optional: lets the "sync now" button start the GitHub workflow
GH_REPO=ElimelechEhrlich/matzpen
ANTHROPIC_API_KEY=       # optional: weekly search for current deals (cellular, internet, electricity)
